# --- Postgres (local install) -------------------------------------------
POSTGRES_USER=rsu
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=rsu_dashboard

# --- Backend (FastAPI) --------------------------------------------------
# Async URL for SQLAlchemy. Point at your local Postgres instance/port.
DATABASE_URL=postgresql+asyncpg://rsu:change-me-in-prod@localhost:5432/rsu_dashboard
# Sync URL used only by Alembic migrations.
DATABASE_URL_SYNC=postgresql+psycopg://rsu:change-me-in-prod@localhost:5432/rsu_dashboard

# Shared secret: NextAuth signs the JWT, FastAPI verifies it with this key.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Seeded on first startup (idempotent).
ADMIN_EMAIL=admin@rsu.local
ADMIN_PASSWORD=change-me-in-prod

# --- Frontend (Next.js) -------------------------------------------------
WEB_PORT=3100
API_PORT=8100
NEXTAUTH_URL=http://localhost:3100
WEB_ORIGIN=http://localhost:3100
# Server-side URL the Next.js app uses to reach FastAPI.
API_URL_INTERNAL=http://localhost:8100
# Server-side URL Playwright uses to render the KPI dashboard print/export page.
PDF_RENDER_BASE_URL=http://localhost:3100
# URL the browser uses.
NEXT_PUBLIC_API_URL=http://localhost:8100
