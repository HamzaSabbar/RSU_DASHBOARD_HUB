# --- Postgres (read by the `db` service) -------------------------------
POSTGRES_USER=rsu
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=rsu_dashboard

# --- Backend (FastAPI) --------------------------------------------------
# Async URL for SQLAlchemy. Host "db" is the compose service name.
DATABASE_URL=postgresql+asyncpg://rsu:change-me-in-prod@db:5432/rsu_dashboard
# Sync URL used only by Alembic migrations.
DATABASE_URL_SYNC=postgresql+psycopg://rsu:change-me-in-prod@db:5432/rsu_dashboard

# Shared secret: NextAuth signs the JWT, FastAPI verifies it with this key.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Seeded on first startup (idempotent).
ADMIN_EMAIL=admin@rsu.local
ADMIN_PASSWORD=change-me-in-prod

# Report workbook storage. Use STORAGE_DRIVER=gcs in deployed environments.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/storage
GCS_BUCKET_NAME=
GCS_PREFIX=rsu-dashboard
REPORT_MAX_UPLOAD_SIZE_MB=50
REPORT_JOB_REPOSITORY=db
REPORT_WORKER_POLL_SECONDS=2

# --- Platform-wide CSV analytics (DuckDB + Parquet/Arrow) --------------
# The source directory is mounted read-only into the analytics worker.
ANALYTICS_SOURCE_PATH=/data/rsu-source
ANALYTICS_LOCAL_PATH=/data/analytics
ANALYTICS_PIPELINE_VERSION=rsu-duckdb-v1
ANALYTICS_MEMORY_LIMIT=4GB
ANALYTICS_THREADS=4
ANALYTICS_TEMP_DIRECTORY=/data/analytics/tmp
ANALYTICS_MAX_TEMP_DIRECTORY_SIZE=20GB
ANALYTICS_WORKER_POLL_SECONDS=2
# Cache only compact dashboard responses, never raw household-level records.
ANALYTICS_CACHE_TTL_SECONDS=900
ANALYTICS_CACHE_MAX_ENTRIES=512
ANALYTICS_CACHE_MAX_BYTES=67108864
ANALYTICS_QUERY_TIMEOUT_SECONDS=60

# --- Frontend (Next.js) -------------------------------------------------
WEB_PORT=3100
API_PORT=8100
DB_PORT=5433
NEXTAUTH_URL=http://localhost:3100
WEB_ORIGIN=http://localhost:3100
# Server-side URL the Next.js app uses to reach FastAPI inside the compose network.
API_URL_INTERNAL=http://api:8000
# Server-side URL Playwright uses to render the print dashboard inside the compose network.
PDF_RENDER_BASE_URL=http://web:3000
# URL the browser uses (goes through the host).
NEXT_PUBLIC_API_URL=http://localhost:8100
